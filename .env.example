# Supabase — ตั้งค่าใน .env (local) และ Vercel → Settings → Environment Variables
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Client key (ปลอดภัยที่จะอยู่ใน bundle เมื่อเปิด RLS แล้ว) — เลือกอย่างใดอย่างหนึ่ง:
#   แนะนำ: publishable key ใหม่ (ขึ้นต้น sb_publishable_…) จาก Supabase → API Keys → Publishable
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
#   (สำรอง/legacy) anon JWT เดิม — โค้ด fallback ให้ ถ้ายังไม่ตั้ง PUBLISHABLE ด้านบน
# VITE_SUPABASE_ANON_KEY=your-legacy-anon-key

# ⚠️ ห้ามใส่ service_role / secret key (sb_secret_…) ที่นี่เด็ดขาด — มัน bypass RLS · ใช้เฉพาะ backend/edge function เท่านั้น
